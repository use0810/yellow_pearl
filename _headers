/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://zipcloud.ibsnet.co.jp; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
